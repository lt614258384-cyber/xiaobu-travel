# ── 小布的旅行 环境变量 ──
# 复制此文件为 .env 并填入真实值

# 数据库连接（SQLite 开发 / PostgreSQL 生产）
DATABASE_URL=sqlite:///xiaobu.db

# 应用密钥 — 用 python -c "import secrets; print(secrets.token_hex(32))" 生成 64 位随机值
SECRET_KEY=dev-secret-change-me

# 数据库密码（PostgreSQL 生产用，需与 docker-compose 一致）
DB_PASSWORD=change-me

# 环境：production 或 development
ENV=development

# 端口
PORT=8000

# 仅在有 HTTPS 反向代理（nginx/Caddy）时设为 true
FORCE_SECURE_COOKIES=false

# 图片生成兜底 Key（可选，用户可在档案页填自己的）
# IMAGE_API_TYPE=seedream
# IMAGE_API_KEY=your-key-here
